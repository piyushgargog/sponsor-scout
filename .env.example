# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# All of these are read server-side only; nothing here is ever sent to the browser.

# ---- Core ----
APP_ENV=development            # development | production
SECRET_KEY=                    # >=32 random chars; REQUIRED in production (also encrypts OAuth tokens at rest)
ADMIN_PASSWORD=                # REQUIRED in production. In development, empty => "demo"
DATABASE_URL=sqlite:///data/app.db

# ---- LLM ----
# mock   offline deterministic demo provider (default; needs nothing)
# cli    PRIMARY real route: drives the Google CLI you signed in to yourself (Sign in with Google, Google AI Pro).
#        No API key is stored or needed by this app. See README "Google AI Pro via the CLI".
# gemini OPTIONAL fallback: Gemini REST API with GEMINI_API_KEY (billed/quota'd separately from AI Pro)
# openai intentional stub
# Empty => gemini if GEMINI_API_KEY is set (legacy behaviour), else mock.
LLM_PROVIDER=mock
LLM_CLI_BIN=agy                # Antigravity CLI binary (name on PATH or absolute path). Legacy: gemini
LLM_CLI_FLAVOR=                # agy | gemini. Empty => detected from LLM_CLI_BIN
LLM_CLI_MODEL=                 # empty => your account/CLI default model. Set only to an id your CLI lists
LLM_CLI_TIMEOUT_SECONDS=180
LLM_CLI_CONCURRENCY=1          # simultaneous CLI calls; keep low to respect your subscription's usage limits
LLM_CLI_PASS_ENV=              # extra env var NAMES the CLI child may inherit (comma separated). App secrets are never inherited
LLM_FIT_ANALYSIS=1             # advisory AI commentary beside the rule-based fit score (1 extra call per researched lead)
LLM_EMAIL_REVIEW=1             # advisory AI fact-check of each draft (1 extra call per draft)
GEMINI_API_KEY=                # only for LLM_PROVIDER=gemini
GEMINI_MODEL=                  # only for LLM_PROVIDER=gemini; empty => auto-discover via models.list

# ---- Search (company discovery) ----
SEARCH_PROVIDER=mock           # mock | brave | google_cse
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---- Gmail OAuth (sending) ----
MAIL_PROVIDER=                 # gmail | mock. Empty => gmail if GOOGLE_CLIENT_ID is set, else mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/gmail/callback

# ---- Sender identity (appended to every email) ----
SENDER_NAME=Your Name
SENDER_ROLE=Sponsorship Team
SENDER_ORG=Your College Tech Club

# ---- Tuning ----
RESEARCH_VERSION=v1
RESEARCH_TTL_DAYS=30
MAX_PAGES_PER_COMPANY=8
FETCH_DELAY_SECONDS=1.0
HIGH_FIT_THRESHOLD=70
MIN_FIT_FOR_EMAIL=40
CAMPAIGN_DAILY_LIMIT=20
SEND_INTERVAL_SECONDS=30       # min gap between sends (forced to 0 in mock mail mode)
COMPANY_COOLDOWN_DAYS=90
WORKER_THREADS=2
WORKER_ENABLED=1               # 0 = web process only; run `python -m app.cli worker` separately
LOG_LEVEL=INFO
