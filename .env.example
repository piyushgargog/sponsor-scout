# ---- Core ----
APP_ENV=development            # development | production
SECRET_KEY=                    # >=32 random chars; REQUIRED in production (also encrypts OAuth tokens)
ADMIN_PASSWORD=                # REQUIRED in production. In development, empty => "demo"
DATABASE_URL=sqlite:///data/app.db

# ---- LLM (Gemini) ----
LLM_PROVIDER=                  # gemini | mock | openai (stub). Empty => gemini if GEMINI_API_KEY is set, else mock
GEMINI_API_KEY=
GEMINI_MODEL=                  # exact model id (e.g. gemini-3.1-pro-preview). Empty => auto-discover via models.list

# ---- Search ----
SEARCH_PROVIDER=mock           # mock | brave | google_cse
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---- Gmail OAuth ----
MAIL_PROVIDER=                 # gmail | mock. Empty => gmail if GOOGLE_CLIENT_ID is set, else mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/gmail/callback

# ---- Sender identity (appended to every email) ----
SENDER_NAME=Your Name
SENDER_ROLE=Sponsorship Team
SENDER_ORG=Your College Tech Club

# ---- Tuning ----
RESEARCH_VERSION=v1
RESEARCH_TTL_DAYS=30
MAX_PAGES_PER_COMPANY=8
FETCH_DELAY_SECONDS=1.0
HIGH_FIT_THRESHOLD=70
MIN_FIT_FOR_EMAIL=40
CAMPAIGN_DAILY_LIMIT=20
SEND_INTERVAL_SECONDS=30       # min gap between sends (forced to 0 in mock mail mode)
COMPANY_COOLDOWN_DAYS=90
WORKER_THREADS=2
WORKER_ENABLED=1               # 0 = web process only; run `python -m app.cli worker` separately
LOG_LEVEL=INFO
